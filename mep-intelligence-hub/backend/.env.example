# Copy to .env (never commit .env). Server-side secrets only — none of these go in the mobile app.
ENVIRONMENT=development
# Supabase Postgres connection string (Settings → Database → Connection string, "Session pooler").
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Supabase project URL. Used to fetch the JWT signing keys (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if your project still uses the legacy shared JWT secret (HS256). Leave empty for JWKS.
SUPABASE_JWT_SECRET=
# Shared secret that pg_cron uses to call /internal/cron/* (Phase 2+).
CRON_SECRET=change-me
# Comma-separated list. Mobile apps don't need CORS; this is for the future admin web.
CORS_ORIGINS=
