# Public values only. These are bundled into the app and visible to anyone with the APK.
# Never put the Claude API key, the Supabase service-role key, or any other secret here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase "publishable" (anon) key — safe to ship; RLS protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI backend base URL, e.g. https://mep-hub-api.fly.dev
EXPO_PUBLIC_API_URL=
